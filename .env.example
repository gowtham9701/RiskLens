# RiskLens environment configuration — copy to .env and fill in
# PostgreSQL (e.g. Neon). Falls back to local SQLite if unset.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Long random string for JWT signing
SECRET_KEY=replace-with-a-long-random-secret
# Comma-separated allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:3000
# Optional LLM API key for news summarisation (graceful fallback if empty)
LLM_API_KEY=
